  {%- if settings.paddi_custom_fonts %}
  :root {
    --font-body-family: 'Paddi Text', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 600;
    --font-heading-family: 'Paddi Condensed', 'Antonio', 'Arial Narrow', sans-serif;
    --font-heading-style: normal;
    --font-heading-weight: 500;
  }
  {%- endif %}
  :root {
    /* Anciennes variables Paddi remappées sur la nouvelle palette (DESIGN.md).
       Les teintes qui servaient de texte passent en ink #161345 (contraste ≥ 13:1 sur clair) ;
       l'orange reste la balle (ponctuation : pastilles, étoiles, lecture vidéo) avec texte ink dessus (7:1). */
    --paddi-nuit: #161345;
    --paddi-nuit-profonde: #161345;
    --paddi-orange: #ff7f00;
    --paddi-orange-survol: #ff7f00;
    --paddi-brique: #161345;
    --paddi-creme: #f9f9f9;
    --paddi-sauge: #60c4bf;
    --paddi-sauge-claire: #d7ecff;
    --paddi-sauge-profonde: #161345;
    --paddi-ardoise: #595959;
    --paddi-sable: #ebebeb;
    --paddi-blanc: #ffffff;
    --paddi-radius-sm: 12px;
    --paddi-radius-md: 20px;
    --paddi-radius-lg: 20px;
    --paddi-shadow: none;
  }
