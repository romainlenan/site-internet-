{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign intro_product = section.settings.product
  assign intro_image = section.settings.image
  if intro_image == blank and intro_product != blank
    assign intro_image = intro_product.featured_image
  endif
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}

<div class="paddi-section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="paddi-header paddi-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="paddi-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="paddi-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="paddi-lead">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="paddi-intro__grid">
      <div class="paddi-intro__col">
        {%- for block in section.blocks limit: half -%}
          <div class="paddi-callout" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="paddi-intro__image">
        <div class="paddi-intro__disk">
          {%- if intro_image != blank -%}
            {{
              intro_image
              | image_url: width: 1000
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 40vw, 90vw',
                widths: '400, 600, 800, 1000',
                alt: intro_image.alt
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
      <div class="paddi-intro__col">
        {%- for block in section.blocks offset: half -%}
          <div class="paddi-callout" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="paddi-intro__footer">
      {%- if intro_product != blank and section.settings.show_price -%}
        <span class="paddi-intro__price">{{ intro_product.price | money }}</span>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        {%- assign intro_link = section.settings.button_link -%}
        {%- if intro_link == blank and intro_product != blank -%}
          {%- assign intro_link = intro_product.url -%}
        {%- endif -%}
        <a class="button button--primary" href="{{ intro_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="paddi-link" href="{{ section.settings.link_url | default: '#caracteristiques' }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Paddi · Le produit",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit présenté" },
    { "type": "image_picker", "id": "image", "label": "Image (sinon, image principale du produit)", "info": "Idéal : photo détourée sur fond crème, format carré." },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Le lanceur" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Voici Paddi." },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "show_price", "label": "Afficher le prix", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir le lanceur" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton", "info": "Vide : page du produit choisi." },
    { "type": "text", "id": "link_label", "label": "Lien secondaire", "default": "Voir toutes les caractéristiques" },
    { "type": "url", "id": "link_url", "label": "Adresse du lien secondaire" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schéma de couleurs", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Point fort",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "3 distances" },
        { "type": "text", "id": "text", "label": "Texte", "default": "Environ 3, 6 ou 9 m." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paddi · Le produit",
      "blocks": [
        { "type": "callout", "settings": { "title": "3 distances de lancer", "text": "Environ 3, 6 ou 9 m, du couloir au jardin." } },
        { "type": "callout", "settings": { "title": "6 balles fournies", "text": "Des balles de tennis de 5 cm, à la taille des petits et moyens chiens." } },
        { "type": "callout", "settings": { "title": "Batterie rechargeable", "text": "Jusqu'à 4 à 5 h par charge selon le fabricant, câble USB fourni." } },
        { "type": "callout", "settings": { "title": "Un bouton, un interrupteur", "text": "Choisissez la distance, allumez, déposez une balle." } }
      ]
    }
  ]
}
{% endschema %}
